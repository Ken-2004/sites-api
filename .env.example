# MongoDB connection URI. Use a dedicated, least-privileged database user.
MONGO_URL=mongodb://localhost:27017/sites

# Long, random value used to sign and verify authentication tokens.
JWT_SECRET=replace-with-a-long-random-secret

# Optional local HTTP port. Vercel supplies its own runtime configuration.
PORT=8080

# Optional allowed CORS origin. Defaults to * for local development.
CORS_ORIGIN=http://localhost:3000
